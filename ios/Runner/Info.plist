<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CADisableMinimumFrameDurationOnPhone</key>
    <true/>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleDisplayName</key>
    <string>Lyfuber</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>ricardo</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(FLUTTER_BUILD_NAME)</string>
    <key>CFBundleSignature</key>
    <string>????</string>
    <key>CFBundleVersion</key>
    <string>$(FLUTTER_BUILD_NUMBER)</string>
    <key>LSApplicationQueriesSchemes</key>
    <array>
        <string>sms</string>
        <string>tel</string>
    </array>
    <key>LSRequiresIPhoneOS</key>
    <true/>

    <!-- Location -->
    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>Lyfuber needs your location to show nearby drivers, track your ride, and ensure accurate pickup and drop-off.</string>
    <key>NSLocationAlwaysUsageDescription</key>
    <string>Lyfuber uses your location in the background to track your ongoing ride and update your driver in real time.</string>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Lyfuber needs your location to find rides near you and show your position on the map.</string>

    <!-- Camera -->
    <key>NSCameraUsageDescription</key>
    <string>Lyfuber needs camera access to let you take and upload your profile photo or verify your identity.</string>

    <!-- Photo Library -->
    <key>NSPhotoLibraryUsageDescription</key>
    <string>Lyfuber needs access to your photo library so you can choose a profile picture or upload required documents.</string>

    <!-- Microphone -->
    <key>NSMicrophoneUsageDescription</key>
    <string>Lyfuber needs microphone access to support in-app voice communication during your ride.</string>

    <!-- Contacts -->
    <key>NSContactsUsageDescription</key>
    <string>Lyfuber needs access to your contacts so you can quickly share ride details or invite friends.</string>

    <!-- Face ID -->
    <key>NSFaceIDUsageDescription</key>
    <string>Lyfuber uses Face ID for quick and secure login to your account.</string>

    <key>UIApplicationSupportsIndirectInputEvents</key>
    <true/>
    <key>UIBackgroundModes</key>
    <array>
        <string>fetch</string>
        <string>location</string>
        <string>remote-notification</string>
    </array>
    <key>UILaunchStoryboardName</key>
    <string>LaunchScreen</string>
    <key>UIMainStoryboardFile</key>
    <string>Main</string>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>io.flutter.embedded_views_preview</key>
    <true/>
</dict>
</plist>